+# The web checkout that owns the active-key definition (mcpindex-web/lib/activeKeys.ts).
+WEB_DIR = os.path.join(REPO, "mcpindex-web")
+# launchd's PATH does not include Homebrew, so look there explicitly before giving up.
+NPM_CANDIDATES = ("/opt/homebrew/bin/npm", "/usr/local/bin/npm")
+
+
+def _npm() -> str:
+    for c in NPM_CANDIDATES:
+        if os.path.exists(c):
+            return c
+    found = shutil.which("npm")
+    if not found:
+        raise RuntimeError("npm not found; active keys unread")
+    return found
+
+
+def active_keys(date: str) -> dict:
+    """North-star metric: api_keys that made authenticated calls on >= 2 distinct UTC days in
+    the 7 days ending on `date`. Delegated to `npm run metrics:active-keys` in mcpindex-web,
+    for the same reason zenodo_citations() delegates: the window and the 2-of-7 rule live in
+    lib/activeKeys.ts and nowhere else, so this file never carries a copy that can drift.
+
+    The Upstash creds are passed through the child's environment only, from the same
+    _upstash_creds() the usage counters use. Nothing here prints them.
+    """
+    creds = _upstash_creds()
+    if not creds:
+        raise RuntimeError("no Upstash REST credentials (env or mcpindex-trust/.env); active keys unread")
+    url, tok = creds
+    env = {**os.environ, "UPSTASH_REDIS_REST_URL": url, "UPSTASH_REDIS_REST_TOKEN": tok}
+    env["PATH"] = os.path.dirname(_npm()) + os.pathsep + env.get("PATH", "")
+    r = subprocess.run(
+        [_npm(), "run", "--silent", "metrics:active-keys", "--", "--date", date],
+        cwd=WEB_DIR, env=env, capture_output=True, text=True, timeout=120,
+    )
+    if r.returncode != 0:
+        raise RuntimeError(f"active-keys exited {r.returncode}: {r.stderr.strip()[:200]}")
+    d = json.loads(r.stdout.strip().splitlines()[-1])
+    # Refuse a shape this file did not expect rather than guess at a number's meaning: the
+    # snapshot never overwrites a month, so a wrong figure is expensive to retract.
+    for k in ("active_keys", "window_start", "window_end", "window_days", "min_days",
+              "distinct_keys_seen", "days_with_data"):
+        if k not in d:
+            raise RuntimeError(f"active-keys output missing {k!r}")
+    return d
 
 
